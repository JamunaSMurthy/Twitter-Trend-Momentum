# Environment Configuration - Copy to .env and fill in your values

# Twitter API Credentials
# Get these from https://developer.twitter.com/en/portal/dashboard
TWITTER_CONSUMER_KEY=your_consumer_key_here
TWITTER_CONSUMER_SECRET=your_consumer_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_TOPIC_TWEETS=tweets
KAFKA_TOPIC_TRENDS=trends
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=root
MONGODB_PASSWORD=password
MONGODB_DATABASE=twitter
MONGODB_URI=mongodb://root:password@localhost:27017/twitter

# Spark Configuration
SPARK_MASTER=local[6]
SPARK_EXECUTOR_MEMORY=5g
SPARK_EXECUTOR_CORES=6
SPARK_BATCH_INTERVAL=15

# Twitter Search Keywords (comma-separated)
TWITTER_SEARCH_KEYWORDS=cryptocurrency,bitcoin,ethereum,trending,technology

# Application Configuration
APP_LOG_LEVEL=INFO
APP_ENVIRONMENT=local

# Sentiment Analysis
SENTIMENT_BATCH_SIZE=100
NLP_THREADS=4

# Performance Tuning
KAFKA_PRODUCER_BATCH_SIZE=16384
KAFKA_PRODUCER_LINGER_MS=10
KAFKA_CONSUMER_GROUP_ID=twitter-trend-momentum-processor
